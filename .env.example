# Local dev needs no env file. `pnpm dev` starts Postgres and Azurite.
# Copy this file to .env only when you set a knob below.
# Secret values are not in git. See docs/specs/environment.md.
# Ask the maintainer for AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, and AUTH_SECRET.

# Google sign-in and the session cookie. Names only. No values in git.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_SECRET=

# Tests only: run the DB in-process via PGlite instead of connecting to a server
# PGLITE_DATA_DIR=memory://

# Unset = your local dev server (postgresql://postgres:postgres@127.0.0.1:5433/postgres).
# Set this and the same code talks to another Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Shared class server etiquette: keep this at 1.
# PG_POOL_MAX=1

# Blob + queue storage. Unset = Azurite, the local emulator (started by
# `pnpm dev`; its data lives in .azurite/). Set this to a real Azure Storage
# connection string and the same code talks to the cloud.
# AZURE_STORAGE_CONNECTION_STRING=

# Label OCR. Unset = every photo "reads" as a fixed sample label. Set this to
# an Azure AI Document Intelligence resource to read real photos.
# OCR_CONNECTION_STRING=Endpoint=https://<resource>.cognitiveservices.azure.com/;Key=<key>

# Log verbosity: debug | info | warn | error
# LOG_LEVEL=info

# Docker Compose (separate from pnpm dev).
# Both Compose files require the three AUTH_* credentials named above.
# Optional local web port; default 3000.
# WEB_PORT=3000

# Production Compose only: use a tested commit tag from GHCR, a strong
# URL-safe database password (for example, random hex), and the public origin.
# AZURE_STORAGE_CONNECTION_STRING above must point to real Azure storage.
# APP_IMAGE=ghcr.io/vicchen199/ingredia/web:<commit-sha>
# POSTGRES_PASSWORD=
# AUTH_URL=https://your-domain.example
